# Runtime data is separate from the installed application.
OMNIOPS_VIDEO_DATA=%LOCALAPPDATA%\OmniOps\VideoStudio

# The packaged application CLI locates the canonical workbench beside itself.
# Set this only when using an independently installed runtime component.
OMNIOPS_VIDEO_WORKBENCH=

# Optional runtime timeout in seconds.
OMNIOPS_VIDEO_TIMEOUT=120

# API credentials are referenced from Windows Credential Manager or process
# environment. They are never placed in this file or the installer.
