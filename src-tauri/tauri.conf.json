{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniOps Video Studio",
  "version": "0.4.0",
  "identifier": "com.omniops.video-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmniOps Video Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "/Volumes/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend/omniops-video-studio-cli.py": "scripts/omniops-video-studio-cli.py",
      "../backend/omniops_video_studio_lib.py": "scripts/omniops_video_studio_lib.py"
    },
    "shortDescription": "OmniOps professional video production",
    "longDescription": "Local professional Worker video creation, generation, QA, and export."
  }
}
